; OrderDesk: a UI Toolkit order-entry application on SQL Connection.
; Reads its connect string from orderdesk.cfg in the current directory.

main orderdesk
.include "CONNECTDIR:ssql.def"
.include "WND:tools.def"
.include "WND:inpctl.def"
.include "WND:toolbar.def"
.include "DBLDIR:windows.def"
.include "ODSRC:theme.inc"

.define TB_HEIGHT, 32
.define TB_INDENT, 4
.define TB_STEP, 28

global data section odstate, init
.include "ODSRC:odstate.inc"
endglobal

global data section lines, init
record
    ln_count    ,i4
    ln_text     ,[100]a72
endglobal

record
    mctl        ,a4000
    colid       ,i4
    inpcol      ,i4
    selcol      ,i4
    tbid        ,i4
    xoff        ,i4
    cfgch       ,i4
    cur         ,i4
    sts         ,i4
    len         ,i4
    ix          ,i4
    rowcnt      ,i4
    initialized ,i4
    scale       ,d4
    scale_text  ,a10
    driver      ,a40
    stage       ,a32
    line        ,a512
    connect     ,a512
    sqlp        ,a256
    msg         ,a1024
proc
    xcall flags(7004020, 1)
    sts = %option(48, 1)
    xcall u_start(, 1)
    ; Scales the window, its contents and the text; ORDERDESK_SCALE overrides 175%.
    scale = 175
    xcall getlog("ORDERDESK_SCALE", scale_text, len)
    if (len)
        scale = scale_text(1:len)
    xcall u_wndfont(D_SETSCALE, scale)
    xcall w_proc(WP_PALET, PAL_BODY, 0, 15)
    xcall w_proc(WP_PALET, PAL_HEAD, 0, 3)
    xcall w_proc(WP_PALET, PAL_LEGACY, 0, 6)
    xcall w_proc(WP_PALET, PAL_FIGURE, 0, 7)
    xcall w_proc(WP_PALET, PAL_NEW, 0, 2)
    xcall e_sect("OrderDesk", D_HEADER)

    .include "ODSRC:config.inc"
    od_driver = driver
    xcall accent_for(driver, od_accent)

    stage = "connecting"
    od_dbchn = 1
    if (%ssc_init(od_dbchn))
        goto fail
    initialized = 1
    if (%ssc_connect(od_dbchn, connect))
        goto fail

    stage = "reading server name"
    sqlp = "SELECT CONVERT(varchar(128),SERVERPROPERTY('ServerName')), DB_NAME()"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto fail
    if (%ssc_define(od_dbchn, cur, 2, od_server, od_database))
        goto fail
    sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
    if ((sts .ne. SSQL_NORMAL) .or. (rowcnt .ne. 1))
        goto fail
    if (%ssc_close(od_dbchn, cur))
        goto fail
    cur = 0
    xcall read_connection
    xcall read_library
    xcall e_sect("OrderDesk - " + %atrim(driver), D_HEADER)

    xcall mb_column(mctl, "FILE", "File", , , , , "F")
    xcall mb_entry(mctl, "FILEFRESH", "Start fresh...")
    xcall mb_line(mctl)
    xcall mb_entry(mctl, "O_EXIT", "Exit", F4_KEY)
    xcall mb_end(mctl, colid)
    xcall mb_column(mctl, "CUST", "Customers", , , , , "C")
    xcall mb_entry(mctl, "CUSBROWSE", "Browse")
    xcall mb_end(mctl, colid)
    xcall mb_column(mctl, "ORD", "Orders", , , , , "O")
    xcall mb_entry(mctl, "ORDNEW", "New order")
    xcall mb_entry(mctl, "ORDPOST", "Post batch (50,000 orders)")
    xcall mb_end(mctl, colid)
    xcall mb_column(mctl, "RPT", "Reports", , , , , "R")
    xcall mb_entry(mctl, "RPTNIGHTLY", "Nightly report (2,000,000 rows)")
    xcall mb_line(mctl)
    xcall mb_entry(mctl, "RPTCOMPARE", "Compare runs")
    xcall mb_end(mctl, colid)
    ; Key columns placed only while I_INPUT or L_SELECT runs; Windows ignores them.
    xcall mb_column(mctl, "INPKEYS", "Input", , D_NOPLC)
    xcall mb_entry(mctl, "I_PREV", "Previous field", UP_KEY)
    xcall mb_entry(mctl, "I_NEXT", "Next field", DOWN_KEY)
    xcall mb_entry(mctl, "O_ABANDON", "Cancel", CTRL_X_KEY)
    xcall mb_end(mctl, inpcol)
    xcall mb_column(mctl, "SELKEYS", "List", , D_NOPLC)
    xcall mb_entry(mctl, "S_UP", "Up", UP_KEY)
    xcall mb_entry(mctl, "S_DOWN", "Down", DOWN_KEY)
    xcall mb_entry(mctl, "O_ABANDON", "Close", CTRL_X_KEY)
    xcall mb_end(mctl, selcol)
    xcall m_defcol(0)

    ; Toolbar buttons signal the same entries as the menus.
    xcall tb_toolbar(TB_CREATE, tbid, TBC_TOP, , TB_HEIGHT)
    xoff = TB_INDENT
    xcall add_tool(tbid, xoff, "CUSBROWSE", "assets\open.bmp", "Browse customers")
    xcall add_tool(tbid, xoff, "ORDNEW", "assets\new.bmp", "New order")
    xcall add_tool(tbid, xoff, "ORDPOST", "assets\save.bmp", "Post batch (50,000 orders)")
    xoff = xoff + TB_STEP / 2
    xcall add_tool(tbid, xoff, "RPTNIGHTLY", "assets\print.bmp", "Nightly report (2,000,000 rows)")
    xcall add_tool(tbid, xoff, "RPTCOMPARE", "assets\preview.bmp", "Compare runs")
    xcall tb_toolbar(TB_PLACE, tbid)

    xcall home_create
    repeat
    begin
        xcall home_refresh
        xcall e_sect("Choose a menu entry or toolbar button")
        xcall m_process
        if (.not. g_select)
            nextloop
        clear g_select
        using g_entnam select
        ("O_EXIT "),        exitloop
        ("FILEFRESH "),     xcall start_fresh
        ("CUSBROWSE "),     xcall cust_browse(selcol)
        ("ORDNEW "),        xcall new_order(inpcol)
        ("ORDPOST "),       xcall post_batch
        ("RPTNIGHTLY "),    xcall nightly_report
        ("RPTCOMPARE "),    xcall compare_runs(selcol)
        endusing
    end

shutdown,
    if (initialized)
        sts = %ssc_release(od_dbchn)
    xcall u_finish
    stop

fail,
    msg = ""
    if (initialized)
    begin
        if (%ssc_getemsg(od_dbchn, msg, len))
            msg = ""
    end
    xcall u_message("OrderDesk could not start: " + %atrim(stage) + "\n" + %atrim(msg), , D_ERROR)
    goto shutdown
endmain

subroutine new_order
    a_inpcol    ,n
.include "CONNECTDIR:ssql.def"
.include "WND:tools.def"
.include "DBLDIR:windows.def"
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
stack record work
    bldid       ,i4
    inpid       ,i4
    saved       ,i4
    entered     ,i4
    found       ,i4
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    cust_id     ,i4
    order_no    ,i4
    sqlp        ,a256
stack record ordrec
    custno      ,d4
    name        ,a40
proc
    init work, ordrec
    xcall e_enter
    entered = 1
    xcall ib_input(bldid, "ORDINP", 3, 60)
    xcall ib_field(bldid, "CUSTNO", D_FLD_TYPE, D_DECIMAL, D_FLD_SIZE, 4,
&       D_FLD_POS, 1, 2, D_FLD_PROMPT, "Customer #", D_FLD_FPOS, 1, 16,
&       D_FLD_REQUIRED, D_FLD_BREAK)
    xcall ib_field(bldid, "NAME", D_FLD_TYPE, D_ALPHA, D_FLD_SIZE, 40,
&       D_FLD_POS, 2, 2, D_FLD_PROMPT, "Name", D_FLD_FPOS, 2, 16, D_FLD_DISABLED)
    xcall ib_button(bldid, "I_OK", DSB_TEXT, "Place order")
    xcall ib_button(bldid, "O_ABANDON", DSB_TEXT, "Cancel")
    xcall ib_end(bldid, inpid)
    xcall w_brdr(inpid, WB_TITLE, "New order")
    xcall u_window(D_PLACE, inpid, 3, 10)
    clear ordrec, saved
    repeat
    begin
        xcall i_input(inpid, , ordrec, a_inpcol, , , D_NOTERM)
        if (g_select) then
        begin
            clear g_select
            exitloop
        end
        else if (g_setsts) then
        begin
            if (g_fldnam .eqs. "CUSTNO")
            begin
                call lookup
                xcall i_display(inpid, , ordrec, "NAME")
            end
        end
        else
        begin
            call lookup
            xcall i_display(inpid, , ordrec, "NAME")
            if (found) then
            begin
                saved = 1
                exitloop
            end
            else
                xcall u_message("There is no customer " + %string(custno) + ".", , D_ERROR)
        end
    end
    xcall e_exit
    clear entered
    if (saved)
        call place
    xreturn

lookup,
    found = 0
    cust_id = custno
    sqlp = "SELECT name FROM customers WHERE id = :1"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT, SSQL_STANDARD, 1, cust_id))
        goto fail
    if (%ssc_define(od_dbchn, cur, 1, name))
        goto fail
    sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
    if ((sts .eq. SSQL_NORMAL) .and. (rowcnt .eq. 1)) then
        found = 1
    else
        name = "(no such customer)"
    sts = %ssc_close(od_dbchn, cur)
    cur = 0
    return

place,
    sqlp = "SELECT MAX(order_no) + 1 FROM orders"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto fail
    if (%ssc_define(od_dbchn, cur, 1, order_no))
        goto fail
    sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
    if ((sts .ne. SSQL_NORMAL) .or. (rowcnt .ne. 1))
        goto fail
    sts = %ssc_close(od_dbchn, cur)
    cur = 0
    sqlp = "INSERT INTO orders (order_no, customer_id) VALUES (:1, :2)"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_NONSEL, SSQL_STANDARD, 2, order_no, cust_id))
        goto fail
    if (%ssc_execute(od_dbchn, cur, SSQL_STANDARD))
        goto fail
    sts = %ssc_close(od_dbchn, cur)
    cur = 0
    if (%ssc_commit(od_dbchn))
        goto fail
    xcall u_message("Order " + %string(order_no) + " placed for " + %atrim(name) + ".")
    return

fail,
    if (entered)
        xcall e_exit
    xcall sql_error("New order")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    sts = %ssc_rollback(od_dbchn, SSQL_TXOFF)
    xreturn
endsubroutine

subroutine post_batch
.include "CONNECTDIR:ssql.def"
.include "WND:tools.def"
.include "DBLDIR:windows.def"
.include "ODSRC:theme.inc"
.define BATCH_ORDERS, 50000
.define BATCH_COMMIT, 1000
.define BATCH_TICK, 2500
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
stack record work
    wid         ,i4
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    failed      ,i4
    live        ,i4
    queries     ,i4
    done        ,i4
    total       ,i4
    tick        ,i4
    cust_id     ,i4
    order_no    ,i4
    pending     ,i4
    sqlp        ,a256
    secs        ,a16
    count_text  ,a20
    trips_text  ,a20
    verdict     ,a200
    start_us    ,i8
    elapsed     ,i8
    tenths      ,i8
    trips       ,i8
    now_trips   ,i8
    start_trips ,i8
    per_query   ,i8
proc
    init work
    total = BATCH_ORDERS
    ; Two back-to-back counter reads measure what one read costs, so the
    ; live readings during the loop can be taken back out of the total.
    xcall read_trips(start_trips, failed, 0)
    if (failed)
        xreturn
    xcall read_trips(trips, failed, 0)
    if (failed)
        xreturn
    per_query = trips - start_trips
    start_trips = trips
    live = 1
    clear done, tick, queries

    xcall e_enter
    xcall w_proc(WP_CREATE, wid, "PROGRESS", 6, 48)
    xcall u_logwnd(wid)
    xcall w_brdr(wid, WB_TITLE, "Post batch")
    xcall w_area(wid, WA_COLOR, PAL_BODY)
    xcall w_disp(wid, WD_COLOR, PAL_BODY, WD_CLR, WDC_WND)
    xcall u_window(D_PLACE, wid, 9, 16)
    xcall show_progress(wid, 0, total, "orders", 0, -1)

    start_us = %datetime_to_i8(%datetime)
    sqlp = "SELECT MAX(order_no) FROM orders"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto fail
    if (%ssc_define(od_dbchn, cur, 1, order_no))
        goto fail
    sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
    if ((sts .ne. SSQL_NORMAL) .or. (rowcnt .ne. 1))
        goto fail
    sts = %ssc_close(od_dbchn, cur)
    cur = 0
    cust_id = 1001
    sqlp = "INSERT INTO orders (order_no, customer_id) VALUES (:1, :2)"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_NONSEL, SSQL_STANDARD, 2, order_no, cust_id))
        goto fail
    for done from 1 thru total
    begin
        incr order_no
        if (%ssc_execute(od_dbchn, cur, SSQL_STANDARD))
            goto fail
        incr pending
        if (pending .eq. BATCH_COMMIT)
        begin
            if (%ssc_commit(od_dbchn))
                goto fail
            clear pending
        end
        incr tick
        if (tick .eq. BATCH_TICK)
            call progress
    end
    if (pending)
    begin
        if (%ssc_commit(od_dbchn))
            goto fail
    end
    done = total
    sts = %ssc_close(od_dbchn, cur)
    cur = 0
    tenths = (%datetime_to_i8(%datetime) - start_us + 50000) / 100000
    xcall u_window(D_DELETE, wid)
    xcall e_exit

    xcall read_trips(trips, failed, 0)
    if (failed)
        xreturn
    trips = trips - start_trips - queries * per_query
    if (trips .lt. 0)
        trips = 0
    xcall record_run("Write", done, tenths, trips)
    xcall fmt_secs(tenths, secs)
    xcall fmt_num(done, count_text)
    xcall fmt_num(trips, trips_text)
    xcall verdict("Write", tenths, trips, verdict)
    if (verdict)
        verdict = "\n\n" + verdict
    xcall u_message("Posted " + %atrim(count_text) + " orders, committed every 1,000" + "\n\n" + %atrim(secs) + "\n" +
&       %atrim(trips_text) + " round trips" + %atrim(verdict))
    xreturn

progress,
    clear tick
    if (live)
    begin
        xcall read_trips(now_trips, failed, 1)
        if (failed) then
            clear live
        else
            incr queries
    end
    elapsed = %datetime_to_i8(%datetime) - start_us
    if (live) then
        xcall show_progress(wid, done, total, "orders", elapsed,
&           now_trips - start_trips - queries * per_query)
    else
        xcall show_progress(wid, done, total, "orders", elapsed, -1)
    return

fail,
    xcall u_window(D_DELETE, wid)
    xcall e_exit
setup_failed,
    xcall sql_error("Post batch")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    sts = %ssc_rollback(od_dbchn, SSQL_TXOFF)
    xreturn
endsubroutine

subroutine nightly_report
.include "CONNECTDIR:ssql.def"
.include "WND:tools.def"
.include "DBLDIR:windows.def"
.include "ODSRC:theme.inc"
.define REPORT_TICK, 100000
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
stack record work
    wid         ,i4
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    failed      ,i4
    live        ,i4
    queries     ,i4
    done        ,i4
    total       ,i4
    tick        ,i4
    report_id   ,i4
    amount      ,d18.4
    payload     ,a128
    sqlp        ,a256
    secs        ,a16
    count_text  ,a20
    trips_text  ,a20
    verdict     ,a200
    start_us    ,i8
    elapsed     ,i8
    tenths      ,i8
    trips       ,i8
    now_trips   ,i8
    start_trips ,i8
    per_query   ,i8
proc
    init work
    sqlp = "SELECT COUNT(*) FROM report_rows"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto setup_failed
    if (%ssc_define(od_dbchn, cur, 1, total))
        goto setup_failed
    sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
    if ((sts .ne. SSQL_NORMAL) .or. (rowcnt .ne. 1))
        goto setup_failed
    sts = %ssc_close(od_dbchn, cur)
    cur = 0
    ; Two back-to-back counter reads measure what one read costs, so the
    ; live readings during the loop can be taken back out of the total.
    xcall read_trips(start_trips, failed, 0)
    if (failed)
        xreturn
    xcall read_trips(trips, failed, 0)
    if (failed)
        xreturn
    per_query = trips - start_trips
    start_trips = trips
    live = 1
    clear done, tick, queries

    xcall e_enter
    xcall w_proc(WP_CREATE, wid, "PROGRESS", 6, 48)
    xcall u_logwnd(wid)
    xcall w_brdr(wid, WB_TITLE, "Nightly report")
    xcall w_area(wid, WA_COLOR, PAL_BODY)
    xcall w_disp(wid, WD_COLOR, PAL_BODY, WD_CLR, WDC_WND)
    xcall u_window(D_PLACE, wid, 9, 16)
    xcall show_progress(wid, 0, total, "rows", 0, -1)

    start_us = %datetime_to_i8(%datetime)
    sqlp = "SELECT id, amount, payload FROM report_rows ORDER BY id"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto fail
    if (%ssc_define(od_dbchn, cur, 3, report_id, amount, payload))
        goto fail
    repeat
    begin
        sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
        if (sts .eq. SSQL_NOMORE)
            exitloop
        if (sts .ne. SSQL_NORMAL)
            goto fail
        incr done
        incr tick
        if (tick .eq. REPORT_TICK)
            call progress
    end
    sts = %ssc_close(od_dbchn, cur)
    cur = 0
    tenths = (%datetime_to_i8(%datetime) - start_us + 50000) / 100000
    xcall u_window(D_DELETE, wid)
    xcall e_exit

    xcall read_trips(trips, failed, 0)
    if (failed)
        xreturn
    trips = trips - start_trips - queries * per_query
    if (trips .lt. 0)
        trips = 0
    xcall record_run("Read", done, tenths, trips)
    xcall fmt_secs(tenths, secs)
    xcall fmt_num(done, count_text)
    xcall fmt_num(trips, trips_text)
    xcall verdict("Read", tenths, trips, verdict)
    if (verdict)
        verdict = "\n\n" + verdict
    xcall u_message("Nightly report read " + %atrim(count_text) + " rows" + "\n\n" + %atrim(secs) + "\n" +
&       %atrim(trips_text) + " round trips" + %atrim(verdict))
    xreturn

progress,
    clear tick
    if (live)
    begin
        xcall read_trips(now_trips, failed, 1)
        if (failed) then
            clear live
        else
            incr queries
    end
    elapsed = %datetime_to_i8(%datetime) - start_us
    if (live) then
        xcall show_progress(wid, done, total, "rows", elapsed,
&           now_trips - start_trips - queries * per_query)
    else
        xcall show_progress(wid, done, total, "rows", elapsed, -1)
    return

fail,
    xcall u_window(D_DELETE, wid)
    xcall e_exit
setup_failed,
    xcall sql_error("Nightly report")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    sts = %ssc_rollback(od_dbchn, SSQL_TXOFF)
    xreturn
endsubroutine

subroutine cust_browse
    a_selcol    ,n
.include "CONNECTDIR:ssql.def"
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
global data section lines
record
    ln_count    ,i4
    ln_text     ,[100]a72
endglobal
stack record work
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    cust_id     ,i4
    name        ,a40
    sqlp        ,a256
proc
    init work
    clear ln_count
    sqlp = "SELECT id, name FROM customers ORDER BY id"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto fail
    if (%ssc_define(od_dbchn, cur, 2, cust_id, name))
        goto fail
    while (ln_count .lt. 100)
    begin
        sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
        if (sts .eq. SSQL_NOMORE)
            exitloop
        if (sts .ne. SSQL_NORMAL)
            goto fail
        incr ln_count
        ln_text[ln_count] = %string(cust_id) + "   " + name
    end
    sts = %ssc_close(od_dbchn, cur)
    xcall show_lines("Customers", "Cust   Name", a_selcol)
    xreturn

fail,
    xcall sql_error("Customers")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    xreturn
endsubroutine

subroutine compare_runs
    a_selcol    ,n
.include "CONNECTDIR:ssql.def"
.include "WND:tools.def"
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
global data section lines
record
    ln_count    ,i4
    ln_text     ,[100]a72
endglobal
stack record work
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    row_count   ,i4
    tenths      ,i4
    trips       ,i8
    driver      ,a40
    step        ,a10
    sqlp        ,a512
stack record cmp
    c_driver    ,a18
    c_step      ,a7
    c_rows      ,a12
    c_time      ,a9
    c_trips     ,a12
proc
    init work, cmp
    clear ln_count
    sqlp = "SELECT driver, step, row_count, tenths, round_trips FROM (" +
&       "SELECT driver, step, row_count, tenths, round_trips, ROW_NUMBER() OVER " +
&       "(PARTITION BY driver, step ORDER BY id DESC) AS rn FROM demo_runs) r " +
&       "WHERE rn = 1 ORDER BY step, CASE WHEN driver LIKE 'VTX12%' THEN 0 ELSE 1 END"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto fail
    if (%ssc_define(od_dbchn, cur, 5, driver, step, row_count, tenths, trips))
        goto fail
    while (ln_count .lt. 100)
    begin
        sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
        if (sts .eq. SSQL_NOMORE)
            exitloop
        if (sts .ne. SSQL_NORMAL)
            goto fail
        c_driver = driver(1:18)
        c_step = step(1:7)
        c_rows = %string(row_count, "ZZ,ZZZ,ZZX")
        xcall fmt_secs(tenths, c_time)
        c_trips = %string(trips, "ZZZ,ZZZ,ZZX")
        incr ln_count
        ln_text[ln_count] = cmp
    end
    sts = %ssc_close(od_dbchn, cur)
    if (.not. ln_count)
    begin
        xcall u_message("No runs yet. Run Reports > Nightly report or Orders > Post batch first.")
        xreturn
    end
    c_driver = "Driver"
    c_step = "Step"
    c_rows = "      Rows"
    c_time = "Time"
    c_trips = "Round trips"
    xcall show_lines("Compare runs", cmp, a_selcol)
    xreturn

fail,
    xcall sql_error("Compare runs")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    xreturn
endsubroutine

; Shows the lines in global data section "lines" as a display-only list.
subroutine show_lines
    a_title     ,a
    a_header    ,a
    a_selcol    ,n
.include "WND:tools.def"
stack record work
    bldid       ,i4
    lstinp      ,i4
    lstid       ,i4
    clsid       ,i4
    req         ,i4
stack record lrec
    ltext       ,a72
proc
    init work, lrec
    xcall e_enter
    xcall e_sect(a_title)
    xcall l_class(clsid, "LINECLS", , , 12, 1, , , , , , "LINE_LOAD")
    xcall ib_input(bldid, "LINES", 1, 74)
    xcall ib_field(bldid, "LTEXT", D_FLD_TYPE, D_ALPHA, D_FLD_SIZE, 72, D_FLD_FPOS, 1, 2)
    xcall ib_end(bldid, lstinp)
    clear lrec
    xcall l_create(lstid, lstinp, lrec, , "LINECLS", 3, 2)
    xcall l_sect(lstid, " " + a_header, D_HEADER)
    xcall l_button(lstid, "O_ABANDON", DSB_TEXT, "Close")
    req = D_LNOP
    repeat
    begin
        xcall l_select(lstid, req, lrec, , , , , , a_selcol)
        if (req .eq. D_LABORT)
            exitloop
        if (g_select)
        begin
            clear g_select
            exitloop
        end
    end
    xcall l_delete(lstid)
    xcall e_exit
    xreturn
endsubroutine

subroutine line_load
    a_listid    ,n
    a_req       ,n
    a_data      ,a
    a_inpid     ,n
    a_disabled  ,n
    a_itemindex ,n
.include "WND:tools.def"
global data section lines
record
    ln_count    ,i4
    ln_text     ,[100]a72
endglobal
stack record lrec
    ltext       ,a72
proc
    init lrec
    if (a_req .ne. D_LLOADBOT .or. a_itemindex .gt. ln_count)
    begin
        a_req = D_LEOF
        xreturn
    end
    ltext = ln_text[a_itemindex]
    xcall i_display(a_inpid, , lrec)
    a_data = lrec
    xreturn
endsubroutine

; Returns the session's network read count, which needs VIEW SERVER STATE.
; With a_quiet set, a failure returns a_failed without showing a message.
subroutine read_trips
    a_trips     ,n
    a_failed    ,n
    a_quiet     ,n
.include "CONNECTDIR:ssql.def"
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
stack record work
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    trips       ,i8
    sqlp        ,a256
proc
    init work
    a_failed = 1
    sqlp = "SELECT CONVERT(bigint,num_reads) FROM sys.dm_exec_connections " +
&       "WHERE session_id = @@SPID AND parent_connection_id IS NULL"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto fail
    if (%ssc_define(od_dbchn, cur, 1, trips))
        goto fail
    sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
    if ((sts .ne. SSQL_NORMAL) .or. (rowcnt .ne. 1))
        goto fail
    sts = %ssc_close(od_dbchn, cur)
    a_trips = trips
    a_failed = 0
    xreturn

fail,
    if (.not. a_quiet)
        xcall sql_error("Counting round trips (does the login have VIEW SERVER STATE?)")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    xreturn
endsubroutine

subroutine record_run
    a_step      ,a
    a_rows      ,n
    a_tenths    ,n
    a_trips     ,n
.include "CONNECTDIR:ssql.def"
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
stack record work
    cur         ,i4
    sts         ,i4
    row_count   ,i4
    tenths      ,i4
    trips       ,i8
    step        ,a10
    sqlp        ,a256
proc
    init work
    step = a_step
    row_count = a_rows
    tenths = a_tenths
    trips = a_trips
    sqlp = "INSERT INTO demo_runs (driver, step, row_count, tenths, round_trips) " +
&       "VALUES (:1, :2, :3, :4, :5)"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_NONSEL, SSQL_STANDARD, 5,
&       od_driver, step, row_count, tenths, trips))
        goto fail
    if (%ssc_execute(od_dbchn, cur, SSQL_STANDARD))
        goto fail
    sts = %ssc_close(od_dbchn, cur)
    if (%ssc_commit(od_dbchn))
        goto fail
    xreturn

fail,
    xcall sql_error("Saving the run for Compare runs")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    sts = %ssc_rollback(od_dbchn, SSQL_TXOFF)
    xreturn
endsubroutine

subroutine sql_error
    a_what      ,a
.include "WND:tools.def"
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
stack record work
    sts         ,i4
    len         ,i4
    sqlcode     ,i4
    msg         ,a1024
proc
    init work
    msg = ""
    clear sqlcode
    sts = %ssc_getemsg(od_dbchn, msg, len,, sqlcode)
    xcall u_message(a_what + " failed\n\nSQLCODE " + %string(sqlcode) + "\n" + %atrim(msg), , D_ERROR)
    xreturn
endsubroutine

subroutine fmt_secs
    a_tenths    ,n
    a_text      ,a
proc
    a_text = %string(a_tenths / 10) + "." + %string(a_tenths - a_tenths / 10 * 10) + "s"
    xreturn
endsubroutine

; Draws a progress bar and live figures in a 6 x 48 window. a_elapsed is in
; microseconds (0 before the first reading); a_trips is -1 when unknown.
subroutine show_progress
    a_wid       ,n
    a_done      ,n
    a_total     ,n
    a_unit      ,a
    a_elapsed   ,n
    a_trips     ,n
.include "WND:tools.def"
.include "DBLDIR:windows.def"
.include "ODSRC:theme.inc"
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
.define BAR_WIDTH, 40
stack record work
    filled      ,i4
    done        ,i8
    rate        ,i8
    tenths      ,i8
    secs        ,a16
    done_text   ,a20
    total_text  ,a20
    rate_text   ,a20
    trips_text  ,a20
    stats       ,a80
    solid       ,a40
    track       ,a40
proc
    init work
    done = a_done
    filled = 0
    if (a_total .gt. 0)
        filled = done * BAR_WIDTH / a_total
    if (filled .gt. BAR_WIDTH)
        filled = BAR_WIDTH
    track = "........................................"
    if (filled)
        xcall w_disp(a_wid, WD_COLOR, od_accent, WD_POS, 2, 4, WD_ATTR, ATTR_LOAD + ATTR_RVRS,
&           solid(1:filled), WD_ATTR, ATTR_LOAD)
    if (filled .lt. BAR_WIDTH)
        xcall w_disp(a_wid, WD_COLOR, od_accent, WD_POS, 2, 4 + filled, track(1:BAR_WIDTH - filled))
    xcall fmt_num(a_done, done_text)
    xcall fmt_num(a_total, total_text)
    xcall w_disp(a_wid, WD_COLOR, PAL_BODY, WD_POS, 4, 4, WD_CLR, WDC_EOL,
&       %atrim(done_text) + " of " + %atrim(total_text) + " " + a_unit)
    if (a_elapsed .gt. 0)
    begin
        tenths = (a_elapsed + 50000) / 100000
        xcall fmt_secs(tenths, secs)
        rate = done * 1000000 / a_elapsed
        xcall fmt_num(rate, rate_text)
        stats = %atrim(secs) + "   " + %atrim(rate_text) + " " + a_unit + "/s"
        if (a_trips .ge. 0)
        begin
            xcall fmt_num(a_trips, trips_text)
            stats = %atrim(stats) + "   " + %atrim(trips_text) + " round trips"
        end
        xcall w_disp(a_wid, WD_COLOR, PAL_FIGURE, WD_POS, 5, 4, WD_CLR, WDC_EOL, stats)
    end
    xcall u_update
    xreturn
endsubroutine

; Reads how SQL Server sees this connection, for the home panel. Failures
; leave the fields blank.
subroutine read_connection
.include "CONNECTDIR:ssql.def"
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
stack record work
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    sqlp        ,a512
proc
    init work
    sqlp = "SELECT COALESCE(s.client_interface_name, ''), " +
&       "COALESCE(CONVERT(varchar(10), c.encrypt_option), ''), COALESCE(c.net_transport, ''), " +
&       "@@SPID, COALESCE(c.net_packet_size, 0) " +
&       "FROM sys.dm_exec_sessions s JOIN sys.dm_exec_connections c " +
&       "ON c.session_id = s.session_id AND c.parent_connection_id IS NULL " +
&       "WHERE s.session_id = @@SPID"
    if (.not. %ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
    begin
        if (.not. %ssc_define(od_dbchn, cur, 5, od_client, od_encrypt, od_transport,
&           od_session, od_packet))
            sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
        sts = %ssc_close(od_dbchn, cur)
    end
    clear cur
    sqlp = "SELECT CASE WHEN CHARINDEX(' (', @@VERSION) > 0 " +
&       "THEN REPLACE(LEFT(@@VERSION, CHARINDEX(' (', @@VERSION) - 1), 'Microsoft ', '') " +
&       "ELSE 'SQL Server' END + ', ' + REPLACE(CONVERT(varchar(60), SERVERPROPERTY('Edition')), " +
&       "' (64-bit)', '') + " +
&       "', ' + CONVERT(varchar(20), SERVERPROPERTY('ProductVersion'))"
    if (.not. %ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
    begin
        if (.not. %ssc_define(od_dbchn, cur, 1, od_version))
            sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
        sts = %ssc_close(od_dbchn, cur)
    end
    xreturn
endsubroutine

; Finds the SQL Connection driver library Windows has loaded in this process:
; rssql.dll once the new driver has been bound, otherwise vtxapits.dll.
subroutine read_library
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
stack record work
    kernel      ,i8
    module      ,i8
    len         ,i4
    path        ,a260
proc
    init work
    od_library = ""
    kernel = %dll_open("kernel32.dll")
    module = %dll_call(kernel, DLL_TYPE_WINAPI, "GetModuleHandleA", "rssql.dll" + %char(0))
    if (.not. module)
        module = %dll_call(kernel, DLL_TYPE_WINAPI, "GetModuleHandleA", "vtxapits.dll" + %char(0))
    if (module)
    begin
        len = %dll_call(kernel, DLL_TYPE_WINAPI, "GetModuleFileNameA", module, path, %integer(260, 4))
        if ((len .gt. 0) .and. (len .le. 260))
            od_library = path(1:len)
    end
    len = %dll_close(kernel)
    xreturn
endsubroutine

; Creates the home panel: a borderless window that fills the screen body,
; behind every other window, with the logo and headings.
subroutine home_create
.include "WND:tools.def"
.include "WND:gblctl.def"
.include "DBLDIR:windows.def"
.include "ODSRC:theme.inc"
.define LOGO_WIDTH, 53
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
stack record work
    r           ,i4
    col         ,i4
    start       ,i4
    logo_col    ,i4
    row         ,a53
    blanks      ,a53
record logo_rows
    lr1         ,a53, " ###  ####  ####  ##### ####  ####  #####  #### #   #"
    lr2         ,a53, "#   # #   # #   # #     #   # #   # #     #     #  # "
    lr3         ,a53, "#   # ####  #   # ####  ####  #   # ####   ###  ###  "
    lr4         ,a53, "#   # #  #  #   # #     #  #  #   # #         # #  # "
    lr5         ,a53, " ###  #   # ####  ##### #   # ####  ##### ####  #   #"
record ,x
    logo        ,[5]a53
proc
    init work
    xcall w_proc(WP_CREATE, od_homeid, "HOME", g_last_row - g_first_row + 1, g_screen_width)
    xcall u_logwnd(od_homeid)
    xcall w_brdr(od_homeid, WB_OFF)
    xcall w_area(od_homeid, WA_COLOR, PAL_BODY)
    xcall w_disp(od_homeid, WD_COLOR, PAL_BODY, WD_CLR, WDC_WND)
    logo_col = (g_screen_width - LOGO_WIDTH) / 2 + 1
    for r from 1 thru 5
    begin
        row = logo[r]
        col = 1
        while (col .le. LOGO_WIDTH)
        begin
            if (row(col:1) .ne. "#") then
                incr col
            else
            begin
                start = col
                repeat
                begin
                    incr col
                    if (col .gt. LOGO_WIDTH)
                        exitloop
                    if (row(col:1) .ne. "#")
                        exitloop
                end
                xcall w_disp(od_homeid, WD_COLOR, od_accent, WD_POS, r + 1, logo_col + start - 1,
&                   WD_ATTR, ATTR_LOAD + ATTR_RVRS, blanks(1:col - start), WD_ATTR, ATTR_LOAD)
            end
        end
    end
    xcall w_disp(od_homeid, WD_COLOR, PAL_HEAD, WD_POS, 7, logo_col + 1,
&       "Order entry and nightly reporting on SQL Connection")
    xcall w_disp(od_homeid, WD_COLOR, PAL_HEAD, WD_ATTR, ATTR_LOAD + ATTR_BOLD,
&       WD_POS, 9, 4, "Connection", WD_POS, 16, 4, "Activity", WD_ATTR, ATTR_LOAD)
    xcall u_window(D_PLACE, od_homeid, g_first_row, 1)
    xreturn
endsubroutine

; Redraws the home panel figures: the connection, and a scoreboard of the
; latest Read and Write run on each driver. Query failures leave a dash
; rather than interrupting the user.
subroutine home_refresh
.include "CONNECTDIR:ssql.def"
.include "WND:tools.def"
.include "DBLDIR:windows.def"
.include "ODSRC:theme.inc"
.define SCORE_BAR, 22
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
stack record work
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    len         ,i4
    ix          ,i4
    customers   ,i4
    orders      ,i4
    tenths      ,i4
    trips       ,i8
    nread       ,i4
    nwrite      ,i4
    srow        ,i4
    first       ,i4
    count       ,i4
    slowest     ,i4
    filled      ,i4
    accent      ,i4
    step        ,a10
    driver      ,a40
    secs        ,a16
    num1        ,a20
    num2        ,a20
    label       ,a8
    session     ,a60
    library     ,a60
    counts      ,a60
    blanks      ,a22
    sqlp        ,a512
    run_driver  ,[4]a40
    run_tenths  ,[4]i4
    run_trips   ,[4]i8
proc
    init work
    counts = "-"
    sqlp = "SELECT (SELECT COUNT(*) FROM customers), (SELECT COUNT(*) FROM orders)"
    if (.not. %ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
    begin
        if (.not. %ssc_define(od_dbchn, cur, 2, customers, orders))
        begin
            sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
            if ((sts .eq. SSQL_NORMAL) .and. (rowcnt .eq. 1))
            begin
                xcall fmt_num(customers, num1)
                xcall fmt_num(orders, num2)
                counts = %atrim(num1) + " customers, " + %atrim(num2) + " orders"
            end
        end
        sts = %ssc_close(od_dbchn, cur)
    end
    clear cur

    ; Slots 1-2 hold Read runs and 3-4 Write runs, legacy first.
    sqlp = "SELECT step, driver, tenths, round_trips FROM (SELECT step, driver, tenths, " +
&       "round_trips, id, ROW_NUMBER() OVER (PARTITION BY driver, step ORDER BY id DESC) AS rn " +
&       "FROM demo_runs) r WHERE rn = 1 " +
&       "ORDER BY step, CASE WHEN driver LIKE 'VTX12%' THEN 0 ELSE 1 END, id DESC"
    if (.not. %ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
    begin
        if (.not. %ssc_define(od_dbchn, cur, 4, step, driver, tenths, trips))
        begin
            while (%ssc_move(od_dbchn, cur, 1, rowcnt) .eq. SSQL_NORMAL)
            begin
                if (step .eqs. "Read") then
                begin
                    if (nread .lt. 2)
                    begin
                        incr nread
                        ix = nread
                        call keep_run
                    end
                end
                else if (nwrite .lt. 2)
                begin
                    incr nwrite
                    ix = 2 + nwrite
                    call keep_run
                end
            end
        end
        sts = %ssc_close(od_dbchn, cur)
    end

    xcall fmt_num(od_session, num1)
    xcall fmt_num(od_packet, num2)
    session = %atrim(num1) + " | " + %atrim(od_client) + " | " + %atrim(od_transport) +
&       " | encrypted " + %atrim(od_encrypt) + " | " + %atrim(num2) + "-byte packets"
    if (.not. od_client)
        session = %atrim(num1) + " | client not reported"
    library = "-"
    len = %trim(od_library)
    if (od_library)
    begin
        if (len .gt. 58) then
            library = "..." + od_library(len - 54:55)
        else
            library = od_library
    end

    xcall w_disp(od_homeid, WD_COLOR, PAL_BODY, WD_POS, 10, 6, WD_CLR, WDC_EOL, "Driver      ",
&       WD_COLOR, od_accent, od_driver)
    xcall w_disp(od_homeid, WD_COLOR, PAL_BODY, WD_POS, 11, 6, WD_CLR, WDC_EOL, "Library     ",
&       WD_COLOR, PAL_FIGURE, library)
    xcall w_disp(od_homeid, WD_COLOR, PAL_BODY, WD_POS, 12, 6, WD_CLR, WDC_EOL, "Server      ",
&       WD_COLOR, PAL_FIGURE, %atrim(od_server) + " / " + od_database)
    xcall w_disp(od_homeid, WD_COLOR, PAL_BODY, WD_POS, 13, 6, WD_CLR, WDC_EOL, "Version     ",
&       WD_COLOR, PAL_FIGURE, od_version)
    xcall w_disp(od_homeid, WD_COLOR, PAL_BODY, WD_POS, 14, 6, WD_CLR, WDC_EOL, "Session     ",
&       WD_COLOR, PAL_FIGURE, session)
    xcall w_disp(od_homeid, WD_COLOR, PAL_BODY, WD_POS, 17, 6, WD_CLR, WDC_EOL, "Data        ",
&       WD_COLOR, PAL_FIGURE, counts)

    label = "Read"
    srow = 19
    first = 1
    count = nread
    call draw_step
    label = "Write"
    srow = 22
    first = 3
    count = nwrite
    call draw_step
    xreturn

keep_run,
    run_driver[ix] = driver
    run_tenths[ix] = tenths
    run_trips[ix] = trips
    return

; Draws up to two runs of one step on rows srow and srow + 1, with each bar
; scaled to the slower run.
draw_step,
    xcall w_disp(od_homeid, WD_POS, srow, 1, WD_CLR, WDC_EOL, WD_POS, srow + 1, 1, WD_CLR, WDC_EOL)
    xcall w_disp(od_homeid, WD_COLOR, PAL_BODY, WD_POS, srow, 6, label)
    if (.not. count)
    begin
        xcall w_disp(od_homeid, WD_COLOR, PAL_BODY, WD_POS, srow, 14, "no runs yet")
        return
    end
    slowest = run_tenths[first]
    if ((count .gt. 1) .and. (run_tenths[first + 1] .gt. slowest))
        slowest = run_tenths[first + 1]
    for ix from first thru first + count - 1
    begin
        xcall accent_for(run_driver[ix], accent)
        xcall w_disp(od_homeid, WD_COLOR, accent, WD_POS, srow + ix - first, 14,
&           run_driver[ix](1:18))
        filled = 1
        if (slowest .gt. 0)
            filled = (run_tenths[ix] * SCORE_BAR + slowest / 2) / slowest
        if (filled .lt. 1)
            filled = 1
        if (filled .gt. SCORE_BAR)
            filled = SCORE_BAR
        xcall w_disp(od_homeid, WD_COLOR, accent, WD_POS, srow + ix - first, 32,
&           WD_ATTR, ATTR_LOAD + ATTR_RVRS, blanks(1:filled), WD_ATTR, ATTR_LOAD)
        xcall fmt_secs(run_tenths[ix], secs)
        xcall fmt_num(run_trips[ix], num1)
        xcall w_disp(od_homeid, WD_COLOR, PAL_FIGURE, WD_POS, srow + ix - first, 56,
&           %atrim(secs), WD_POS, srow + ix - first, 64, %atrim(num1) + " trips")
    end
    return
endsubroutine

subroutine add_tool
    a_tbid      ,n
    a_xoff      ,n
    a_name      ,a
    a_bitmap    ,a
    a_tip       ,a
.include "WND:tools.def"
.include "WND:toolbar.def"
.define TB_INDENT, 4
.define TB_SIZE, 24
.define TB_STEP, 28
proc
    xcall tb_button(a_tbid, TBB_LOAD, a_name, a_xoff, TB_INDENT, TB_SIZE, TB_SIZE,
&       TBLOAD_TYPE_BMAP, a_bitmap, a_tip, , , "toolbar_method")
    a_xoff = a_xoff + TB_STEP
    xreturn
endsubroutine

.subroutine toolbar_method ,reentrant
a_btnname   ,a
.proc
    xcall m_signal(a_btnname)
    xreturn
.end

; Builds the comparison against the other driver's latest run of the same step,
; such as "2.4x faster than VTX12_SQLNATIVE". Empty when there is none yet.
subroutine verdict
    a_step      ,a
    a_tenths    ,n
    a_trips     ,n
    a_text      ,a
.include "CONNECTDIR:ssql.def"
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
stack record work
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    other_tenths,i4
    other_trips ,i8
    mine_tenths ,i8
    mine_trips  ,i8
    ratio       ,i8
    step        ,a10
    other       ,a40
    speed       ,a100
    trips       ,a100
    sqlp        ,a256
proc
    init work
    a_text = ""
    step = a_step
    mine_tenths = a_tenths
    mine_trips = a_trips
    sqlp = "SELECT TOP 1 driver, tenths, round_trips FROM demo_runs " +
&       "WHERE step = :1 AND driver <> :2 ORDER BY id DESC"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT, SSQL_STANDARD, 2, step, od_driver))
        goto done
    if (%ssc_define(od_dbchn, cur, 3, other, other_tenths, other_trips))
        goto done
    sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
    if ((sts .ne. SSQL_NORMAL) .or. (rowcnt .ne. 1))
        goto done
    if ((mine_tenths .le. 0) .or. (other_tenths .le. 0))
        goto done

    ratio = (other_tenths * 10 + mine_tenths / 2) / mine_tenths
    if (ratio .ge. 11) then
        speed = %string(ratio / 10) + "." + %string(ratio - ratio / 10 * 10) + "x faster than " +
&           %atrim(other)
    else if (ratio .le. 9) then
    begin
        ratio = (mine_tenths * 10 + other_tenths / 2) / other_tenths
        speed = %string(ratio / 10) + "." + %string(ratio - ratio / 10 * 10) + "x slower than " +
&           %atrim(other)
    end
    else
        speed = "About the same speed as " + %atrim(other)

    trips = ""
    if ((mine_trips .gt. 0) .and. (other_trips .gt. 0))
    begin
        ratio = (other_trips * 10 + mine_trips / 2) / mine_trips
        if (ratio .ge. 11) then
            trips = %string(ratio / 10) + "." + %string(ratio - ratio / 10 * 10) + "x fewer round trips"
        else if (ratio .le. 9) then
        begin
            ratio = (mine_trips * 10 + other_trips / 2) / other_trips
            trips = %string(ratio / 10) + "." + %string(ratio - ratio / 10 * 10) + "x more round trips"
        end
        else
            trips = "About the same round trips"
    end
    a_text = speed
    if (trips)
        a_text = %atrim(speed) + "\n" + trips

done,
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    xreturn
endsubroutine

; Formats a whole number with thousands separators and no leading blanks.
subroutine fmt_num
    a_value     ,n
    a_text      ,a
stack record work
    buf         ,a15
    ix          ,i4
proc
    init work
    buf = %string(a_value, "ZZZ,ZZZ,ZZZ,ZZX")
    for ix from 1 thru 15
        if (buf(ix:1) .ne. " ")
            exitloop
    a_text = buf(ix, 15)
    xreturn
endsubroutine

; Deletes the recorded runs and the orders the demo posted, after asking, so
; the scoreboard and Compare runs start empty. Seed order 10420 stays.
subroutine start_fresh
.include "CONNECTDIR:ssql.def"
.include "WND:tools.def"
global data section odstate
.include "ODSRC:odstate.inc"
endglobal
stack record work
    cur         ,i4
    sts         ,i4
    sqlp        ,a128
proc
    init work
    if (%u_msgbox("Delete all recorded runs and the orders the demo has posted?",
&       D_MYESNO + D_MICONQUESTION, "Start fresh") .ne. D_MIDYES)
        xreturn
    sqlp = "DELETE FROM demo_runs"
    call run_delete
    sqlp = "DELETE FROM orders WHERE order_no > 10420"
    call run_delete
    if (%ssc_commit(od_dbchn))
        goto fail
    xcall u_message("Recorded runs and demo orders deleted.")
    xreturn

run_delete,
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_NONSEL))
        goto fail
    if (%ssc_execute(od_dbchn, cur, SSQL_STANDARD))
        goto fail
    sts = %ssc_close(od_dbchn, cur)
    clear cur
    return

fail,
    xcall sql_error("Start fresh")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    sts = %ssc_rollback(od_dbchn, SSQL_TXOFF)
    xreturn
endsubroutine

; Returns the palette entry for a driver's accent colour: green for the new
; driver's connect-string prefixes, amber for everything else.
subroutine accent_for
    a_driver    ,a
    a_palette   ,n
.include "ODSRC:theme.inc"
stack record work
    token       ,a40
proc
    init work
    token = a_driver
    upcase token
    if ((token .eqs. "SQLSERVER") .or. (token .eqs. "VTX12_SYN")) then
        a_palette = PAL_NEW
    else
        a_palette = PAL_LEGACY
    xreturn
endsubroutine
