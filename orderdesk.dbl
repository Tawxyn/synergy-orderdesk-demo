; OrderDesk: a UI Toolkit order-entry application on SQL Connection.
; Reads its connect string from orderdesk.cfg in the current directory.

main orderdesk
.include "CONNECTDIR:ssql.def"
.include "WND:tools.def"
.include "WND:inpctl.def"

global data section odstate, init
record
    od_dbchn    ,d1
    od_driver   ,a40
endglobal

global data section lines, init
record
    ln_count    ,i4
    ln_text     ,[100]a72
endglobal

record
    mctl        ,a4000
    colid       ,i4
    inpcol      ,i4
    selcol      ,i4
    cfgch       ,i4
    logch       ,i4
    cur         ,i4
    sts         ,i4
    len         ,i4
    ix          ,i4
    rowcnt      ,i4
    initialized ,i4
    problems    ,i4
    driver      ,a40
    server      ,a128
    database    ,a128
    stage       ,a32
    line        ,a512
    connect     ,a512
    sqlp        ,a256
    msg         ,a1024
    rejected    ,a2048
proc
    xcall flags(7004020, 1)
    sts = %option(48, 1)
    xcall u_start(, 1, 1)
    xcall e_sect("OrderDesk", D_HEADER)

    .include "config.inc"
    od_driver = driver

    stage = "connecting"
    xcall e_sect("Connecting with " + %atrim(driver) + "...", D_FOOTER, D_LEFT)
    od_dbchn = 1
    if (%ssc_init(od_dbchn))
        goto fail
    initialized = 1
    if (%ssc_connect(od_dbchn, connect))
        goto fail

    ; Connection settings
    logch = 0
    open(logch, o, "orderdesk.log")
    if (%ssc_cmd(od_dbchn, , SSQL_CMD_SSL, "3;SSL=yes;SSL_PROTOCOL=1.2"))
        call setting_failed
    if (%ssc_cmd(od_dbchn, , SSQL_PERFORMANCE_SQL, "yes"))
        call setting_failed
    if (%ssc_cmd(od_dbchn, , SSQL_CMD_NOUNICHAR, "no"))
        call setting_failed
    close logch
    if (problems)
    begin
        xcall u_message("The " + %atrim(driver) + " driver rejected " + %string(problems) +
&           " connection settings:\n" + %atrim(rejected) + "\n\nDetails are in orderdesk.log.",
&           , D_ERROR)
        goto shutdown
    end

    stage = "reading server name"
    sqlp = "SELECT CONVERT(varchar(128),SERVERPROPERTY('ServerName')), DB_NAME()"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto fail
    if (%ssc_define(od_dbchn, cur, 2, server, database))
        goto fail
    sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
    if ((sts .ne. SSQL_NORMAL) .or. (rowcnt .ne. 1))
        goto fail
    if (%ssc_close(od_dbchn, cur))
        goto fail
    cur = 0
    xcall e_sect("OrderDesk - " + %atrim(driver) + " - " + %atrim(server) + " / " +
&       %atrim(database), D_HEADER)
    xcall e_sect("Connected with " + %atrim(driver), D_FOOTER, D_LEFT)

    xcall mb_column(mctl, "FILE", "File", , , , , "F")
    xcall mb_entry(mctl, "O_EXIT", "Exit", F4_KEY)
    xcall mb_end(mctl, colid)
    xcall mb_column(mctl, "CUST", "Customers", , , , , "C")
    xcall mb_entry(mctl, "CUSBROWSE", "Browse")
    xcall mb_end(mctl, colid)
    xcall mb_column(mctl, "ORD", "Orders", , , , , "O")
    xcall mb_entry(mctl, "ORDNEW", "New order")
    xcall mb_entry(mctl, "ORDPOST", "Post batch (1,000 orders)")
    xcall mb_end(mctl, colid)
    xcall mb_column(mctl, "RPT", "Reports", , , , , "R")
    xcall mb_entry(mctl, "RPTNIGHTLY", "Nightly report (1,000,000 rows)")
    xcall mb_line(mctl)
    xcall mb_entry(mctl, "RPTCOMPARE", "Compare runs")
    xcall mb_end(mctl, colid)
    ; Key columns placed only while I_INPUT or L_SELECT runs; Windows ignores them.
    xcall mb_column(mctl, "INPKEYS", "Input", , D_NOPLC)
    xcall mb_entry(mctl, "I_PREV", "Previous field", UP_KEY)
    xcall mb_entry(mctl, "I_NEXT", "Next field", DOWN_KEY)
    xcall mb_entry(mctl, "O_ABANDON", "Cancel", CTRL_X_KEY)
    xcall mb_end(mctl, inpcol)
    xcall mb_column(mctl, "SELKEYS", "List", , D_NOPLC)
    xcall mb_entry(mctl, "S_UP", "Up", UP_KEY)
    xcall mb_entry(mctl, "S_DOWN", "Down", DOWN_KEY)
    xcall mb_entry(mctl, "O_ABANDON", "Close", CTRL_X_KEY)
    xcall mb_end(mctl, selcol)
    xcall m_defcol(0)

    repeat
    begin
        xcall e_sect("Choose a menu entry")
        xcall m_process
        if (.not. g_select)
            nextloop
        clear g_select
        using g_entnam select
        ("O_EXIT "),        exitloop
        ("CUSBROWSE "),     xcall cust_browse(selcol)
        ("ORDNEW "),        xcall new_order(inpcol)
        ("ORDPOST "),       xcall post_batch
        ("RPTNIGHTLY "),    xcall nightly_report
        ("RPTCOMPARE "),    xcall compare_runs(selcol)
        endusing
    end

shutdown,
    if (initialized)
        sts = %ssc_release(od_dbchn)
    xcall u_finish
    stop

setting_failed,
    msg = ""
    if (%ssc_getemsg(od_dbchn, msg, len))
        msg = "unknown error"
    incr problems
    if (problems .eq. 1) then
        rejected = %atrim(msg)
    else
        rejected = %atrim(rejected) + "\n" + %atrim(msg)
    writes(logch, %atrim(msg))
    return

fail,
    msg = ""
    if (initialized)
    begin
        if (%ssc_getemsg(od_dbchn, msg, len))
            msg = ""
    end
    xcall u_message("OrderDesk could not start: " + %atrim(stage) + "\n" + %atrim(msg), , D_ERROR)
    goto shutdown
endmain

subroutine new_order
    a_inpcol    ,n
.include "CONNECTDIR:ssql.def"
.include "WND:tools.def"
.include "DBLDIR:windows.def"
global data section odstate
record
    od_dbchn    ,d1
    od_driver   ,a40
endglobal
record
    bldid       ,i4
    inpid       ,i4
    saved       ,i4
    entered     ,i4
    found       ,i4
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    cust_id     ,i4
    order_no    ,i4
    sqlp        ,a256
record ordrec
    custno      ,d4
    name        ,a40
proc
    xcall e_enter
    entered = 1
    xcall ib_input(bldid, "ORDINP", 3, 60)
    xcall ib_field(bldid, "CUSTNO", D_FLD_TYPE, D_DECIMAL, D_FLD_SIZE, 4,
&       D_FLD_POS, 1, 2, D_FLD_PROMPT, "Customer #", D_FLD_FPOS, 1, 16,
&       D_FLD_REQUIRED, D_FLD_BREAK)
    xcall ib_field(bldid, "NAME", D_FLD_TYPE, D_ALPHA, D_FLD_SIZE, 40,
&       D_FLD_POS, 2, 2, D_FLD_PROMPT, "Name", D_FLD_FPOS, 2, 16, D_FLD_DISABLED)
    xcall ib_button(bldid, "I_OK", DSB_TEXT, "Place order")
    xcall ib_button(bldid, "O_ABANDON", DSB_TEXT, "Cancel")
    xcall ib_end(bldid, inpid)
    xcall w_brdr(inpid, WB_TITLE, "New order")
    xcall u_window(D_PLACE, inpid, 3, 10)
    clear ordrec, saved
    repeat
    begin
        xcall i_input(inpid, , ordrec, a_inpcol, , , D_NOTERM)
        if (g_select) then
        begin
            clear g_select
            exitloop
        end
        else if (g_setsts) then
        begin
            if (g_fldnam .eqs. "CUSTNO")
            begin
                call lookup
                xcall i_display(inpid, , ordrec, "NAME")
            end
        end
        else
        begin
            call lookup
            xcall i_display(inpid, , ordrec, "NAME")
            if (found) then
            begin
                saved = 1
                exitloop
            end
            else
                xcall u_message("There is no customer " + %string(custno) + ".", , D_ERROR)
        end
    end
    xcall e_exit
    clear entered
    if (saved)
        call place
    xreturn

lookup,
    found = 0
    cust_id = custno
    sqlp = "SELECT name FROM customers WHERE id = :1"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT, SSQL_STANDARD, 1, cust_id))
        goto fail
    if (%ssc_define(od_dbchn, cur, 1, name))
        goto fail
    sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
    if ((sts .eq. SSQL_NORMAL) .and. (rowcnt .eq. 1)) then
        found = 1
    else
        name = "(no such customer)"
    sts = %ssc_close(od_dbchn, cur)
    cur = 0
    return

place,
    sqlp = "SELECT MAX(order_no) + 1 FROM orders"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto fail
    if (%ssc_define(od_dbchn, cur, 1, order_no))
        goto fail
    sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
    if ((sts .ne. SSQL_NORMAL) .or. (rowcnt .ne. 1))
        goto fail
    sts = %ssc_close(od_dbchn, cur)
    cur = 0
    sqlp = "INSERT INTO orders (order_no, customer_id) VALUES (:1, :2)"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_NONSEL, SSQL_STANDARD, 2, order_no, cust_id))
        goto fail
    if (%ssc_execute(od_dbchn, cur, SSQL_STANDARD))
        goto fail
    sts = %ssc_close(od_dbchn, cur)
    cur = 0
    if (%ssc_commit(od_dbchn))
        goto fail
    xcall u_message("Order " + %string(order_no) + " placed for " + %atrim(name) + ".")
    return

fail,
    if (entered)
        xcall e_exit
    xcall sql_error("New order")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    sts = %ssc_rollback(od_dbchn, SSQL_TXOFF)
    xreturn
endsubroutine

subroutine post_batch
.include "CONNECTDIR:ssql.def"
.include "WND:tools.def"
.include "DBLDIR:windows.def"
.define BATCH_ORDERS, 1000
.define BATCH_TICK, 100
global data section odstate
record
    od_dbchn    ,d1
    od_driver   ,a40
endglobal
record
    wid         ,i4
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    failed      ,i4
    posted      ,i4
    tick        ,i4
    cust_id     ,i4
    order_no    ,i4
    sqlp        ,a256
    secs        ,a16
    start_us    ,i8
    tenths      ,i8
    trips       ,i8
    start_trips ,i8
proc
    xcall read_trips(start_trips, failed)
    if (failed)
        xreturn
    xcall e_enter
    xcall w_proc(WP_CREATE, wid, "PROGRESS", 3, 40)
    xcall u_logwnd(wid)
    xcall w_brdr(wid, WB_TITLE, "Post batch")
    xcall u_window(D_PLACE, wid, 8, 20)
    xcall w_disp(wid, WD_POS, 2, 2, "Posting orders...")
    xcall u_update

    start_us = %datetime_to_i8(%datetime)
    sqlp = "SELECT MAX(order_no) FROM orders"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto fail
    if (%ssc_define(od_dbchn, cur, 1, order_no))
        goto fail
    sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
    if ((sts .ne. SSQL_NORMAL) .or. (rowcnt .ne. 1))
        goto fail
    sts = %ssc_close(od_dbchn, cur)
    cur = 0
    cust_id = 1001
    sqlp = "INSERT INTO orders (order_no, customer_id) VALUES (:1, :2)"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_NONSEL, SSQL_STANDARD, 2, order_no, cust_id))
        goto fail
    for posted from 1 thru BATCH_ORDERS
    begin
        incr order_no
        if (%ssc_execute(od_dbchn, cur, SSQL_STANDARD))
            goto fail
        if (%ssc_commit(od_dbchn))
            goto fail
        incr tick
        if (tick .eq. BATCH_TICK)
        begin
            clear tick
            xcall w_disp(wid, WD_POS, 2, 2, WD_CLR, WDC_EOL, %string(posted, "Z,ZZX") + " orders")
            xcall u_update
        end
    end
    tenths = (%datetime_to_i8(%datetime) - start_us + 50000) / 100000
    sts = %ssc_close(od_dbchn, cur)
    cur = 0
    xcall u_window(D_DELETE, wid)
    xcall e_exit

    xcall read_trips(trips, failed)
    if (failed)
        xreturn
    trips = trips - start_trips
    xcall record_run("Write", BATCH_ORDERS, tenths, trips)
    xcall fmt_secs(tenths, secs)
    xcall u_message("Posted " + %string(BATCH_ORDERS, "Z,ZZX") + " orders, one transaction each\n\n" +
&       %atrim(secs) + "\n" + %string(trips, "Z,ZZZ,ZZX") + " round trips")
    xreturn

fail,
    xcall u_window(D_DELETE, wid)
    xcall e_exit
    xcall sql_error("Post batch")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    sts = %ssc_rollback(od_dbchn, SSQL_TXOFF)
    xreturn
endsubroutine

subroutine nightly_report
.include "CONNECTDIR:ssql.def"
.include "WND:tools.def"
.include "DBLDIR:windows.def"
.define REPORT_TICK, 50000
global data section odstate
record
    od_dbchn    ,d1
    od_driver   ,a40
endglobal
record
    wid         ,i4
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    failed      ,i4
    rows        ,i4
    tick        ,i4
    report_id   ,i4
    amount      ,d18.4
    payload     ,a128
    sqlp        ,a256
    secs        ,a16
    start_us    ,i8
    tenths      ,i8
    trips       ,i8
    start_trips ,i8
proc
    xcall read_trips(start_trips, failed)
    if (failed)
        xreturn
    xcall e_enter
    xcall w_proc(WP_CREATE, wid, "PROGRESS", 3, 40)
    xcall u_logwnd(wid)
    xcall w_brdr(wid, WB_TITLE, "Nightly report")
    xcall u_window(D_PLACE, wid, 8, 20)
    xcall w_disp(wid, WD_POS, 2, 2, "Reading rows...")
    xcall u_update

    start_us = %datetime_to_i8(%datetime)
    sqlp = "SELECT id, amount, payload FROM report_rows ORDER BY id"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto fail
    if (%ssc_define(od_dbchn, cur, 3, report_id, amount, payload))
        goto fail
    repeat
    begin
        sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
        if (sts .eq. SSQL_NOMORE)
            exitloop
        if (sts .ne. SSQL_NORMAL)
            goto fail
        incr rows
        incr tick
        if (tick .eq. REPORT_TICK)
        begin
            clear tick
            xcall w_disp(wid, WD_POS, 2, 2, WD_CLR, WDC_EOL, %string(rows, "Z,ZZZ,ZZX") + " rows")
            xcall u_update
        end
    end
    sts = %ssc_close(od_dbchn, cur)
    cur = 0
    tenths = (%datetime_to_i8(%datetime) - start_us + 50000) / 100000
    xcall u_window(D_DELETE, wid)
    xcall e_exit

    xcall read_trips(trips, failed)
    if (failed)
        xreturn
    trips = trips - start_trips
    xcall record_run("Read", rows, tenths, trips)
    xcall fmt_secs(tenths, secs)
    xcall u_message("Nightly report read " + %string(rows, "Z,ZZZ,ZZX") + " rows\n\n" +
&       %atrim(secs) + "\n" + %string(trips, "Z,ZZZ,ZZX") + " round trips")
    xreturn

fail,
    xcall u_window(D_DELETE, wid)
    xcall e_exit
    xcall sql_error("Nightly report")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    xreturn
endsubroutine

subroutine cust_browse
    a_selcol    ,n
.include "CONNECTDIR:ssql.def"
global data section odstate
record
    od_dbchn    ,d1
    od_driver   ,a40
endglobal
global data section lines
record
    ln_count    ,i4
    ln_text     ,[100]a72
endglobal
record
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    cust_id     ,i4
    name        ,a40
    sqlp        ,a256
proc
    clear ln_count
    sqlp = "SELECT id, name FROM customers ORDER BY id"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto fail
    if (%ssc_define(od_dbchn, cur, 2, cust_id, name))
        goto fail
    while (ln_count .lt. 100)
    begin
        sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
        if (sts .eq. SSQL_NOMORE)
            exitloop
        if (sts .ne. SSQL_NORMAL)
            goto fail
        incr ln_count
        ln_text[ln_count] = %string(cust_id) + "   " + name
    end
    sts = %ssc_close(od_dbchn, cur)
    xcall show_lines("Customers", "Cust   Name", a_selcol)
    xreturn

fail,
    xcall sql_error("Customers")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    xreturn
endsubroutine

subroutine compare_runs
    a_selcol    ,n
.include "CONNECTDIR:ssql.def"
.include "WND:tools.def"
global data section odstate
record
    od_dbchn    ,d1
    od_driver   ,a40
endglobal
global data section lines
record
    ln_count    ,i4
    ln_text     ,[100]a72
endglobal
record
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    row_count   ,i4
    tenths      ,i4
    trips       ,i8
    driver      ,a40
    step        ,a10
    sqlp        ,a512
record cmp
    c_driver    ,a18
    c_step      ,a7
    c_rows      ,a12
    c_time      ,a9
    c_trips     ,a12
proc
    clear ln_count
    sqlp = "SELECT driver, step, row_count, tenths, round_trips FROM (" +
&       "SELECT driver, step, row_count, tenths, round_trips, ROW_NUMBER() OVER " +
&       "(PARTITION BY driver, step ORDER BY id DESC) AS rn FROM demo_runs) r " +
&       "WHERE rn = 1 ORDER BY step, CASE WHEN driver LIKE 'VTX12%' THEN 0 ELSE 1 END"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto fail
    if (%ssc_define(od_dbchn, cur, 5, driver, step, row_count, tenths, trips))
        goto fail
    while (ln_count .lt. 100)
    begin
        sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
        if (sts .eq. SSQL_NOMORE)
            exitloop
        if (sts .ne. SSQL_NORMAL)
            goto fail
        c_driver = driver(1:18)
        c_step = step(1:7)
        c_rows = %string(row_count, "ZZ,ZZZ,ZZX")
        xcall fmt_secs(tenths, c_time)
        c_trips = %string(trips, "ZZZ,ZZZ,ZZX")
        incr ln_count
        ln_text[ln_count] = cmp
    end
    sts = %ssc_close(od_dbchn, cur)
    if (.not. ln_count)
    begin
        xcall u_message("No runs yet. Run Reports > Nightly report or Orders > Post batch first.")
        xreturn
    end
    c_driver = "Driver"
    c_step = "Step"
    c_rows = "      Rows"
    c_time = "Time"
    c_trips = "Round trips"
    xcall show_lines("Compare runs", cmp, a_selcol)
    xreturn

fail,
    xcall sql_error("Compare runs")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    xreturn
endsubroutine

; Shows the lines in global data section "lines" as a display-only list.
subroutine show_lines
    a_title     ,a
    a_header    ,a
    a_selcol    ,n
.include "WND:tools.def"
record
    bldid       ,i4
    lstinp      ,i4
    lstid       ,i4
    clsid       ,i4
    req         ,i4
record lrec
    ltext       ,a72
proc
    xcall e_enter
    xcall e_sect(a_title)
    xcall l_class(clsid, "LINECLS", , , 12, 1, , , , , , "LINE_LOAD")
    xcall ib_input(bldid, "LINES", 1, 74)
    xcall ib_field(bldid, "LTEXT", D_FLD_TYPE, D_ALPHA, D_FLD_SIZE, 72, D_FLD_FPOS, 1, 2)
    xcall ib_end(bldid, lstinp)
    clear lrec
    xcall l_create(lstid, lstinp, lrec, , "LINECLS", 3, 2)
    xcall l_sect(lstid, " " + a_header, D_HEADER)
    xcall l_button(lstid, "O_ABANDON", DSB_TEXT, "Close")
    req = D_LNOP
    repeat
    begin
        xcall l_select(lstid, req, lrec, , , , , , a_selcol)
        if (req .eq. D_LABORT)
            exitloop
        if (g_select)
        begin
            clear g_select
            exitloop
        end
    end
    xcall l_delete(lstid)
    xcall e_exit
    xreturn
endsubroutine

subroutine line_load
    a_listid    ,n
    a_req       ,n
    a_data      ,a
    a_inpid     ,n
    a_disabled  ,n
    a_itemindex ,n
.include "WND:tools.def"
global data section lines
record
    ln_count    ,i4
    ln_text     ,[100]a72
endglobal
record lrec
    ltext       ,a72
proc
    if (a_req .ne. D_LLOADBOT .or. a_itemindex .gt. ln_count)
    begin
        a_req = D_LEOF
        xreturn
    end
    ltext = ln_text[a_itemindex]
    xcall i_display(a_inpid, , lrec)
    a_data = lrec
    xreturn
endsubroutine

; Returns the session's network read count, which needs VIEW SERVER STATE.
subroutine read_trips
    a_trips     ,n
    a_failed    ,n
.include "CONNECTDIR:ssql.def"
global data section odstate
record
    od_dbchn    ,d1
    od_driver   ,a40
endglobal
record
    cur         ,i4
    sts         ,i4
    rowcnt      ,i4
    trips       ,i8
    sqlp        ,a256
proc
    a_failed = 1
    sqlp = "SELECT CONVERT(bigint,num_reads) FROM sys.dm_exec_connections " +
&       "WHERE session_id = @@SPID AND parent_connection_id IS NULL"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_SELECT))
        goto fail
    if (%ssc_define(od_dbchn, cur, 1, trips))
        goto fail
    sts = %ssc_move(od_dbchn, cur, 1, rowcnt)
    if ((sts .ne. SSQL_NORMAL) .or. (rowcnt .ne. 1))
        goto fail
    sts = %ssc_close(od_dbchn, cur)
    a_trips = trips
    a_failed = 0
    xreturn

fail,
    xcall sql_error("Counting round trips (does the login have VIEW SERVER STATE?)")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    xreturn
endsubroutine

subroutine record_run
    a_step      ,a
    a_rows      ,n
    a_tenths    ,n
    a_trips     ,n
.include "CONNECTDIR:ssql.def"
global data section odstate
record
    od_dbchn    ,d1
    od_driver   ,a40
endglobal
record
    cur         ,i4
    sts         ,i4
    row_count   ,i4
    tenths      ,i4
    trips       ,i8
    step        ,a10
    sqlp        ,a256
proc
    step = a_step
    row_count = a_rows
    tenths = a_tenths
    trips = a_trips
    sqlp = "INSERT INTO demo_runs (driver, step, row_count, tenths, round_trips) " +
&       "VALUES (:1, :2, :3, :4, :5)"
    if (%ssc_open(od_dbchn, cur, sqlp, SSQL_NONSEL, SSQL_STANDARD, 5,
&       od_driver, step, row_count, tenths, trips))
        goto fail
    if (%ssc_execute(od_dbchn, cur, SSQL_STANDARD))
        goto fail
    sts = %ssc_close(od_dbchn, cur)
    if (%ssc_commit(od_dbchn))
        goto fail
    xreturn

fail,
    xcall sql_error("Saving the run for Compare runs")
    if (cur)
        sts = %ssc_close(od_dbchn, cur)
    sts = %ssc_rollback(od_dbchn, SSQL_TXOFF)
    xreturn
endsubroutine

subroutine sql_error
    a_what      ,a
.include "WND:tools.def"
global data section odstate
record
    od_dbchn    ,d1
    od_driver   ,a40
endglobal
record
    sts         ,i4
    len         ,i4
    sqlcode     ,i4
    msg         ,a1024
proc
    msg = ""
    clear sqlcode
    sts = %ssc_getemsg(od_dbchn, msg, len,, sqlcode)
    xcall u_message(a_what + " failed\n\nSQLCODE " + %string(sqlcode) + "\n" + %atrim(msg), , D_ERROR)
    xreturn
endsubroutine

subroutine fmt_secs
    a_tenths    ,n
    a_text      ,a
proc
    a_text = %string(a_tenths / 10) + "." + %string(a_tenths - a_tenths / 10 * 10) + "s"
    xreturn
endsubroutine
